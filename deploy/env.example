# Окружение продакшена. Файл кладётся в /etc/checkbudget/checkbudget.env
# с правами 0640 root:checkbudget — приложение его читает, посторонние нет.
#
# provision.sh создаёт этот файл сам и заполняет секреты сгенерированными
# значениями. Здесь — образец с пояснениями, что каждая строка значит.

NODE_ENV=production
PORT=3001
# Слушать только петлю: наружу приложение смотрит через nginx, и открытый
# порт 3001 в интернет означал бы обход TLS и заголовков прокси.
HOST=127.0.0.1

# Подпись токенов доступа. 64 hex-символа. При смене все сессии слетают —
# это нормальная реакция на компрометацию и плохая идея «на всякий случай».
JWT_SECRET=

# Роль приложения. Она НЕ владеет таблицами и не имеет BYPASSRLS:
# владелец обходит RLS везде, где не включён FORCE, и второй рубеж
# защиты исчез бы молча.
DATABASE_URL=postgres://checkbudget_app:PASSWORD@127.0.0.1:5432/checkbudget

# Рассылка событий между инстансами. Роль читает только журнал событий
# и две колонки users. Нужна даже одному инстансу: через неё работает
# LISTEN/NOTIFY, и добавление второго инстанса не потребует правок.
DATABASE_REPLICATION_URL=postgres://checkbudget_replicator:PASSWORD@127.0.0.1:5432/checkbudget

# Размер пула. Правило: (ядра БД × 2) + диски, делённое на число инстансов.
# На двух ядрах не нужно больше — пул шире, чем база способна обслужить,
# лишь переносит очередь в базу, где её хуже видно.
DATABASE_POOL_SIZE=6

# CORS не нужен: nginx отдаёт клиент и API с одного домена. Значение
# оставлено на случай отдельного домена под API.
CORS_ORIGINS=https://__DOMAIN__

# Лимиты запросов. По умолчанию 10 на /auth/* и 300 на остальное за минуту.
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=300
